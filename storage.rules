rules_version = '2';

// ============================================================================
// REGRAS DO STORAGE — Taíse Foto
// Fotos públicas (galeria, capas, imagens do site) podem ser vistas por
// qualquer um. Enviar, trocar ou apagar arquivos: só administradores, só
// imagens e no máximo 12 MB por arquivo. O site já reduz e converte as fotos
// para WebP antes de enviar, então o normal é ficar bem abaixo disso.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['tarufino@gmail.com', 'marcelinhojordao07@gmail.com'];
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
