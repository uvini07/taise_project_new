{
  "name": "taise-foto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Taíse Foto — site público e painel administrativo (React + Firebase)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-taisefoto \"vitest run --config vitest.rules.config.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-taisefoto --import ./.emulator-data --export-on-exit",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
